# ═══════════════════════════════════════════════════════════════
# SACCO Middleware Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git
# ═══════════════════════════════════════════════════════════════

# ── API Gateway ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://sacco_user:sacco_pass@localhost:5432/sacco_middleware

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Hyperledger Besu ───────────────────────────────────────────
BESU_RPC_URL=http://localhost:8545

# Address of the deployed AnchorRegistry smart contract
# Run: cd blockchain && npx hardhat run scripts/deploy.js --network besu
ANCHOR_CONTRACT_ADDRESS=

# Private key of the account that deploys and calls the contract (hex, no 0x prefix)
# Generate with: node -e "const {randomBytes}=require('crypto'); console.log(randomBytes(32).toString('hex'))"
DEPLOYER_PRIVATE_KEY=

# ── Signing Keys ───────────────────────────────────────────────
# Ed25519 private key for signing QR receipt payloads (PKCS8 DER hex)
# Generated automatically when registering a tenant via POST /v1/tenants/register
SIGNING_PRIVATE_KEY=

# ── Anchor Worker ──────────────────────────────────────────────
ANCHOR_BATCH_SIZE=50
ANCHOR_INTERVAL_SECONDS=15
ANCHOR_HEALTH_PORT=3001

# ── Reconciliation Engine ──────────────────────────────────────
# Cron schedule: default every 5 minutes
RECONCILE_CRON=*/5 * * * *
METRICS_PORT=9091

# ── SMS Verification Service ───────────────────────────────────
SMS_PORT=3002

# Africa's Talking credentials
# Get free sandbox credentials at: https://africastalking.com
AT_API_KEY=sandbox
AT_USERNAME=sandbox
AT_SENDER_ID=SACCO

# ── Email Alerts ───────────────────────────────────────────────
ALERT_EMAIL_FROM=alerts@yoursacco.ug
ALERT_EMAIL_TO=manager@yoursacco.ug
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Dashboard ──────────────────────────────────────────────────
DASHBOARD_PORT=3003

# ── SACCO Simulator (demo only) ────────────────────────────────
SIMULATOR_PORT=3004
GATEWAY_URL=http://localhost:3000
# These are set when you register a tenant:
SACCO_API_KEY=
SACCO_HMAC_KEY=

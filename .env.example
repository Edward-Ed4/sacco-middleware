# API Gateway
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://sacco_user:sacco_pass@localhost:5432/sacco_middleware

# Redis
REDIS_URL=redis://localhost:6379

# Hyperledger Besu RPC
BESU_RPC_URL=http://localhost:8545
ANCHOR_CONTRACT_ADDRESS=

# Ed25519 signing key (hex, 32 bytes)
SIGNING_PRIVATE_KEY=

# HMAC key for SMS verification codes (hex, 32 bytes)
SMS_HMAC_KEY=

# SMS Gateway (Africa's Talking)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=SACCO

# Alert service
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Reconciliation schedule (cron)
RECONCILE_CRON=*/5 * * * *

# Anchor batch settings
ANCHOR_BATCH_SIZE=50
ANCHOR_INTERVAL_SECONDS=15
